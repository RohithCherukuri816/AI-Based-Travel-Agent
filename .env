APP_NAME=AI Travel Planning Agent
APP_VERSION=2.0.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=1
DATABASE_URL=sqlite:///./travel_agent.db
REDIS_URL=redis://localhost:6379
GOOGLE_AI_API_KEY=your_gemini_api_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
OPENWEATHER_API_KEY=your_open_weather_api_key
AMADEUS_CLIENT_ID= your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
RAPIDAPI_KEY=your_rapid_api_key
RAPIDAPI_HOTEL_HOST=hotels4.p.rapidapi.com  
BOOKING_API_KEY=your_booking_api_key
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
ENABLE_AI_CHAT=true
ENABLE_ANALYTICS=true
ENABLE_PAYMENTS=true
ENABLE_REAL_APIS=true
ENABLE_WEBSOCKETS=true
